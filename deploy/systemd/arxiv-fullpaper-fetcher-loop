#!/bin/sh
set -u

: "${FULLPAPER_FETCH_LIMIT:=100}"
: "${FULLPAPER_FETCH_CATEGORIES:=cs.AI,cs.LG,cs.CL,cs.CV,stat.ML,cs.RO}"
: "${FULLPAPER_FETCH_ORDER:=recent}"
: "${FULLPAPER_FETCH_RATE_LIMIT_SECONDS:=3}"
: "${FULLPAPER_FETCH_SLEEP_SECONDS:=60}"

while true; do
  docker exec \
    -e FULLPAPER_FETCH_LIMIT="${FULLPAPER_FETCH_LIMIT}" \
    -e FULLPAPER_FETCH_CATEGORIES="${FULLPAPER_FETCH_CATEGORIES}" \
    -e FULLPAPER_FETCH_ORDER="${FULLPAPER_FETCH_ORDER}" \
    -e FULLPAPER_FETCH_RATE_LIMIT_SECONDS="${FULLPAPER_FETCH_RATE_LIMIT_SECONDS}" \
    arxiv-container sh -lc 'PYTHONUNBUFFERED=1 python3 /app/tools/fetch_full_paper_text.py --limit "$FULLPAPER_FETCH_LIMIT" --categories "$FULLPAPER_FETCH_CATEGORIES" --order "$FULLPAPER_FETCH_ORDER" --rate-limit-seconds "$FULLPAPER_FETCH_RATE_LIMIT_SECONDS"'
  sleep "${FULLPAPER_FETCH_SLEEP_SECONDS}"
done
